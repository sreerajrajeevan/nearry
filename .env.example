# Copy to .env and fill in. The app runs in MOCK MODE when these are empty.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth (Expo AuthSession). Create OAuth clients in Google Cloud Console.
# For dev, Expo's proxy can be used: EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
