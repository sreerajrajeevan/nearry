# Copy to .env and fill in. Empty = backend not configured (real auth and
# data calls will error clearly; use the explicit demo from the welcome screen).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in needs NO app-side client id. It is configured once in the
# Supabase dashboard (Auth -> Providers -> Google) with a Google Cloud OAuth
# client; the app drives it through supabase.auth.signInWithOAuth().

# Real place search uses the authenticated Supabase `place-search` function.
# Set GEOAPIFY_API_KEY only in Supabase Edge Function secrets, NOT here or in
# EXPO_PUBLIC_* variables. See docs/place-search.md for migration/deployment.

# Public EAS project UUID (Expo dashboard); required to register native push.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Public privacy-policy owner and support contact. Fill before release.
EXPO_PUBLIC_LEGAL_OWNER=
EXPO_PUBLIC_SUPPORT_EMAIL=
