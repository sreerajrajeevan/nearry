# Copy to .env and fill in. Empty = backend not configured (real auth and
# data calls will error clearly; use the explicit demo from the welcome screen).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in needs NO app-side client id. It is configured once in the
# Supabase dashboard (Auth -> Providers -> Google) with a Google Cloud OAuth
# client; the app drives it through supabase.auth.signInWithOAuth().
