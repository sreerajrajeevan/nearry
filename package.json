    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "^2.47.0",
    "expo": "~54.0.38",
    "expo-asset": "~12.0.14",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "main": "expo/AppEntry.js",
  "name": "nearry",
  "private": true,
  "scripts": {
    "android": "expo start --android",
    "ios": "expo run:ios",
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:database": "tsx --test tests/database.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "sql:generate": "node scripts/generate-sql.mjs",
    "sql:check": "node scripts/generate-sql.mjs --check",
    "assets": "python3 assets/generate_icons.py",
    "legal:export": "node --env-file-if-exists=.env --import tsx scripts/export-legal.ts",
    "release:check": "node --env-file-if-exists=.env scripts/check-release.mjs",
    "eas-build-post-install": "node scripts/check-eas-build.mjs"
  },
  "version": "0.1.0"
}
